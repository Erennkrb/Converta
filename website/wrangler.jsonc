// Static site for converta.erenk.de, served by Cloudflare Workers.
// Deploy: npx wrangler deploy   (run inside this folder)
{
  "name": "converta-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "converta.erenk.de", "custom_domain": true }
  ]
}
